VIVADEO_API_KEY=change-me
VIVADEO_INTERNAL_SERVICE_KEY=change-me-too
VIVADEO_SETTINGS_ENCRYPTION_KEY=generate-a-long-random-secret
VIVADEO_DEFAULT_ORG_ID=default-workspace
VIVADEO_MODAL_CONFIG_PATH=./.modal.toml
EMAIL_FROM=DoNotReply@your-azure-managed-domain.azurecomm.net
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...;accesskey=...
DATABASE_URL=postgresql+psycopg://vivadeo:vivadeo@postgres:5432/vivadeo
AUTH_DATABASE_URL=postgres://vivadeo:vivadeo@postgres:5432/vivadeo
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-vivadeo-better-auth-secret-change-before-production
REDIS_URL=redis://redis:6379/0
VIVADEO_DB_POOL_SIZE=3
VIVADEO_DB_MAX_OVERFLOW=2
VIVADEO_DB_POOL_TIMEOUT=30
VIVADEO_DB_POOL_RECYCLE=1800
VIVADEO_WORKER_CONCURRENCY=4
# Use "azure" for Azure Blob or "s3" for an S3-compatible service.
STORAGE_BACKEND=azure
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:3000/api/proxy/v1/media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=vivadeo
AZURE_STORAGE_TIMEOUT=300
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_WHISPER_DEPLOYMENT=
AZURE_OPENAI_WHISPER_TIMEOUT=900
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_BUCKET=vivadeo
S3_ACCESS_KEY_ID=<s3-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_REGION=eu-central-003
VIVADEO_MODAL_APP=vivadeo-qwen3-vl-embedding-2b
VIVADEO_MODAL_CLASS=QwenEmbedder
# Optional Pro OpenAI-compatible gateway; keep credentials out of source control.
VIVADEO_PRO_LLM_API_KEY=
VIVADEO_PRO_LLM_BASE_URL=
VIVADEO_PRO_LLM_MODEL=gpt-5.6-luna
VIVADEO_PRO_EMBEDDING_API_KEY=
VIVADEO_PRO_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
VIVADEO_PRO_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
VIVADEO_CHUNK_DURATION=30
VIVADEO_CHUNK_OVERLAP=5
VIVADEO_BATCH_SIZE=4
VIVADEO_PREPROCESS=true
VIVADEO_TARGET_RESOLUTION=480
VIVADEO_TARGET_FPS=5
VIVADEO_SKIP_STILL=false
API_INTERNAL_URL=http://api:8000
